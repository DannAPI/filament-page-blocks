{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "dannapi/filament-page-blocks",
    "description": "Structured page blocks for Laravel and Filament.",
    "keywords": [
        "laravel",
        "filament",
        "page-builder",
        "content-blocks"
    ],
    "homepage": "https://github.com/DannAPI/filament-page-blocks",
    "authors": [
        {
            "name": "Danylo Korotieiev",
            "email": "forgest30@gmail.com",
            "homepage": "https://github.com/DannAPI"
        }
    ],
    "support": {
        "issues": "https://github.com/DannAPI/filament-page-blocks/issues",
        "source": "https://github.com/DannAPI/filament-page-blocks"
    },
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "filament/filament": "^5.0",
        "illuminate/cache": "^13.0",
        "illuminate/console": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/database": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/routing": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0",
        "symfony/html-sanitizer": "^8.0",
        "symfony/process": "^8.0"
    },
    "autoload": {
        "files": [
            "src/helpers.php"
        ],
        "psr-4": {
            "DannAPI\\FilamentPageBlocks\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "DannAPI\\FilamentPageBlocks\\PageBlocksServiceProvider"
            ],
            "aliases": {
                "PageBlocks": "DannAPI\\FilamentPageBlocks\\Facades\\PageBlocks"
            }
        }
    },
    "config": {
        "sort-packages": true
    }
}
